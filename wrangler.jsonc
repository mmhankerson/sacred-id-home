{
  "name": "sacred-id-home",
  "compatibility_date": "2026-09-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "sacredidentitystudio.com/blog",
      "zone_name": "sacredidentitystudio.com"
    },
    {
      "pattern": "sacredidentitystudio.com/blog/*",
      "zone_name": "sacredidentitystudio.com"
    },
    {
      "pattern": "sacredidentitystudio.com/articles",
      "zone_name": "sacredidentitystudio.com"
    },
    {
      "pattern": "sacredidentitystudio.com/articles/*",
      "zone_name": "sacredidentitystudio.com"
    }
  ]
}
